LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Browser control (Playwright MCP). See README for what each one does.
# Show the browser window on this machine. Set true for a headless run.
BROWSER_HEADLESS=false
# Throwaway profile per call: no cookies or logins are kept between calls.
# Set false to keep a profile in BROWSER_OUTPUT_DIR/profile instead.
BROWSER_ISOLATED=true
# chromium (bundled), chrome, msedge, firefox, or webkit.
BROWSER_KIND=chromium
# Where screenshots, downloads, and page-derived files land.
# BROWSER_OUTPUT_DIR=./.browser-workspace
# Timeout for one browser step. Page loads often need well over the 5s default.
BROWSER_TIMEOUT_SECONDS=120
# Cap on text handed back to the model from one browser step.
BROWSER_MAX_RESULT_CHARS=8000
# Exposes browser_evaluate and browser_run_code_unsafe, which run arbitrary
# JavaScript in the browser. Leave off unless you know why you want it.
BROWSER_ALLOW_UNSAFE_TOOLS=false

# Claude Code (claude mcp serve). See README for what the agent may do with it.
# Set false to leave Claude Code out of the agent entirely.
CLAUDE_CODE_ENABLED=true
# Path to the claude executable. Defaults to claude on PATH, then the copy
# inside the Claude Code VS Code extension.
# CLAUDE_CODE_COMMAND=/usr/local/bin/claude
# Folder Claude Code works in. Defaults to this project.
# CLAUDE_CODE_WORKDIR=.
# Timeout for one Claude Code step. A delegated agent task can take minutes.
CLAUDE_CODE_TIMEOUT_SECONDS=600
# Cap on text handed back to the model from one Claude Code step.
CLAUDE_CODE_MAX_RESULT_CHARS=8000

# Obsidian (Local REST API plugin). Obsidian must be open for these to work.
# Each vault runs its own copy of the plugin, so give each one its own port in
# Obsidian > Settings > Local REST API with MCP, and list the vaults here by a
# short id (letters, digits and _). Per vault, with <ID> the id in capitals:
#   OBSIDIAN_<ID>_API_KEY  the API key from that vault's plugin settings
#   OBSIDIAN_<ID>_NAME     what you call it out loud (default: the id)
#   OBSIDIAN_<ID>_URL      default https://127.0.0.1:27124
#   OBSIDIAN_<ID>_CA_CERT  default ./certs/obsidian-<id>.crt
#   OBSIDIAN_<ID>_DIR      the vault's folder on disk; needed only to read PDFs
# The first vault listed is the default when no vault is named.
OBSIDIAN_VAULTS=
# Example:
# OBSIDIAN_VAULTS=trading
# OBSIDIAN_TRADING_NAME=Trading Research
# OBSIDIAN_TRADING_API_KEY=
# OBSIDIAN_TRADING_URL=https://127.0.0.1:27124
# OBSIDIAN_TRADING_DIR=/Users/you/Obsidian Documents/Trading Research
# Cap on how much of one note or PDF is handed to the model.
OBSIDIAN_MAX_NOTE_CHARS=6000

# PDF reading, through ../pdf-reader-mcp (build it with `go build -o pdf-reader .`
# there). It uses GOOGLE_API_KEY and may only read inside the OBSIDIAN_<ID>_DIR
# folders. Each PDF read is uploaded to Gemini and needs the user's approval.
# PDF_READER_COMMAND=../pdf-reader-mcp/pdf-reader
# PDF_READER_MODEL=gemini-3.5-flash
# Tried in turn when Google says the model above is busy (503) or rate-limited.
# PDF_READER_FALLBACK_MODELS=gemini-3.8-flash,gemini-flash-latest
# PDF_READER_TIMEOUT_SECONDS=150

# Where Coffy records every approval request, answer, and refused action.
# COFFY_AUDIT_LOG=./logs/approvals.jsonl
