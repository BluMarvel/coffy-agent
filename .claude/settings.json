{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(git push *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(launchctl *)",
      "Bash(security *)",
      "Read(./.env*)",
      "Read(./frontend/.env*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(./.env*)",
      "Edit(./frontend/.env*)",
      "Edit(./certs/**)",
      "Edit(./launchd/**)",
      "Edit(./.claude/**)",
      "Edit(~/Library/LaunchAgents/**)"
    ]
  }
}
